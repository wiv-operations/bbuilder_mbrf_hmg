{
    "type": "module",
    "scripts": {
        "test": "bbuilder test",
        "type-check": "tsc --noEmit",
        "prepare": "husky",
        "validate": "bbuilder validate",
        "coverage-check": "node scripts/check-coverage.mjs",
        "pull": "bbuilder pull && npm run pull:subflows",
        "pull:subflows": "node .agents/skills/blip-subflows/scripts/subflows.mjs pull --all",
        "postinstall": "node .agents/skills/blip-subflows/scripts/patch-blip-sdk.mjs && node .agents/skills/blip-subflows/scripts/patch-bbuilder.mjs"
    },
    "dependencies": {
        "bbuilder": "0.0.13"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "husky": "^9.1.7",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22.18.0"
    }
}
