          "action": "{{state.previous.name}} - {{input.content}}"
        },
        "conditions": []
      },
      {
        "type": "ExecuteScript",
        "settings": {
          "function": "run",
          "source": "function run(inputContent) {\n\tlet redirect = \"{{resource.redirect@vagasMbrf}}\"\n\n\tlet previous = \"{{state.previous.id}}\";\n\tlet previousSubFlow = \"{{stateSubFluxo}}\";\n\ttry {\n\t\treturn {\n\t\t\t\"origin\": redirect,\n\t\t\t\"lastState\": previousSubFlow ? previousSubFlow : previous,\n\t\t\t\"lastName\": \"{{state.previous.name}}\",\n\t\t\t\"inputType\": \"menu dinamico\",\n\t\t\tinputContent\n\t\t};\n\n\t} catch (error) {\n\t\treturn \"ERROR_FORMATTING_INPUT_CONTENT\"\n\t}\n}",
          "inputVariables": [
            "input.content"
          ],
          "outputVariable": "inputExcecoes",
          "LocalTimeZoneEnabled": false
        },
        "conditions": []
      },
      {
        "type": "SetVariable",
        "settings": {
          "variable": "stateSubFluxo",
          "expiration": 1
        },
        "conditions": []
      }
    ],
    "$leavingCustomActions": [
      {
        "type": "Redirect",
        "settings": {
          "context": {
            "type": "text/plain",
            "value": "{{inputExcecoes}}"
          },
          "address": "{{resource.redirect@excecao}}"
        },
        "conditions": []
      },
      {
        "type": "TrackEvent",
        "settings": {
          "extras": {},
          "category": "[{{application.identifier}}][{{state.name}}] Exibição",
          "action": "Saida"
        },
        "conditions": []
      }
    ],
    "$defaultOutput": {
