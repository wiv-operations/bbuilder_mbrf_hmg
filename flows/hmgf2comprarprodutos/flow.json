      {
        "$description": "",
        "$inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "type": "ExecuteScript",
        "settings": {
          "function": "run",
          "source": "function run(itensCarrinhoFormatado) {\n    try {\n        const dados = typeof itensCarrinhoFormatado === \"string\"\n            ? JSON.parse(itensCarrinhoFormatado)\n            : itensCarrinhoFormatado;\n\n        const pedidos = (dados && dados.pedidos) || [];\n\n        if (!pedidos.length) {\n            return \"\";\n        }\n\n        // 1234.5 -> \"1.234,50\" (sem \"R$\", porque o texto já tem o prefixo)\n        const formatarValor = v => (Math.round((Number(v) || 0) * 100) / 100)\n            .toFixed(2)\n            .replace(\".\", \",\")\n            .replace(/\\B(?=(\\d{3})+(?!\\d))/g, \".\");\n\n        const itens = pedidos.map(item =>\n            \"Item: \" + (item.produto || \"\") + \"\\n\" +\n            \"Quantidade: \" + (Number(item.quantidade) || 0) + \"\\n\" +\n            \"Preço: R$\" + formatarValor(item.valorUnitario)\n        ).join(\"\\n\\n\");\n\n        // Total com desconto; se não vier, usa o subtotal ou soma os itens\n        const somaItens = pedidos.reduce((s, i) => s + (Number(i.subtotal) || 0), 0);\n        const valorTotal = dados.total != null ? dados.total\n            : dados.subtotal != null ? dados.subtotal\n            : somaItens;\n\n        return \"Percebi que seu último pedido com a gente foi esse:\\n\\n\" +\n            itens + \"\\n\\n\" +\n            \"Total do pedido: R$\" + formatarValor(valorTotal) + \"\\n\\n\" +\n            \"*Gostaria de repetir o mesmo pedido?*\";\n\n    } catch (error) {\n        return \"\";\n    }\n}",
          "inputVariables": [
            "itensCarrinhoFormatado"
          ],
          "outputVariable": "textoUltimaCompra",
          "LocalTimeZoneEnabled": false
        },
        "conditions": []
      }
    ],
    "$leavingCustomActions": [
      {
        "type": "ExecuteScript",
        "settings": {
          "function": "run",
          "source": "function run(input) {\n  try {\n    let opcoesMenu = {\n      \"1\": \"Repetir pedido\",\n      \"2\": \"Fazer novo pedido\",\n      \"3\": \"🔥 Ver ofertas\"\n    };\n    \n    let menuRegex = {\n      \"1\": /\\b(?:1|um|repetir(?:\\s+pedido)?|mesmo|igual|anterior)\\b/i,\n      \"2\": /\\b(?:2|dois|novo(?:\\s+pedido)?|pedido|pedir|fazer|comprar)\\b/i,\n      \"3\": /\\b(?:3|tr[êe]s|ofertas?|promo[çc][õo]es|promo[çc][ãa]o|promo|ver(?:\\s+ofertas?)?)\\b/i,\n    };\n\n    input = input.trim();\n\n    for (let prop in menuRegex) {\n      if (menuRegex[prop].test(input)) {\n        return opcoesMenu[prop];\n      }\n    }\n\n    return \"Input inesperado\";\n  } catch (error) {\n    return \"Input inesperado\";\n  }\n}",
          "inputVariables": [
            "input.content"
          ],
          "outputVariable": "intentAction",
          "LocalTimeZoneEnabled": false
        },
        "conditions": []
      },
