    "$leavingCustomActions": [
      {
        "$description": "",
        "$inputSchema": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "type": "ExecuteScript",
        "settings": {
          "function": "run",
          "source": "function run(horaEntrada, horaFim) {\n  try {\n    function parseDataGMT0(dataTexto) {\n      const [data, hora] = dataTexto.split(\" \");\n      const [mes, dia, ano] = data.split(\"/\");\n      const [hh, mm, ss] = hora.split(\":\");\n\n      return new Date(Date.UTC(ano, mes - 1, dia, hh, mm, ss));\n    }\n\n    function formatarBrasil(data) {\n      const dataBrasil = new Date(data.getTime() - 3 * 60 * 60 * 1000);\n\n      const dia = String(dataBrasil.getUTCDate()).padStart(2, \"0\");\n      const mes = String(dataBrasil.getUTCMonth() + 1).padStart(2, \"0\");\n      const ano = dataBrasil.getUTCFullYear();\n\n      const hora = String(dataBrasil.getUTCHours()).padStart(2, \"0\");\n      const minuto = String(dataBrasil.getUTCMinutes()).padStart(2, \"0\");\n\n      return {\n        data: `${dia}/${mes}/${ano}`,\n        hora: `${hora}:${minuto}`\n      };\n    }\n\n    const entrada = parseDataGMT0(horaEntrada);\n    const fim = parseDataGMT0(horaFim);\n\n    const diferencaMs = fim - entrada;\n    const totalSegundos = Math.floor(diferencaMs / 1000);\n    const totalMinutos = Math.floor(totalSegundos / 60);\n\n    const horas = Math.floor(totalMinutos / 60);\n    const minutos = totalMinutos % 60;\n    const segundos = totalSegundos % 60;\n\n    const entradaFormatada = formatarBrasil(entrada);\n    const fimFormatada = formatarBrasil(fim);\n\n    let tempoTexto = \"\";\n\n    if (horas > 0) {\n      tempoTexto += `${horas} ${horas === 1 ? \"hora\" : \"horas\"}`;\n    }\n\n    if (minutos > 0) {\n      if (tempoTexto) tempoTexto += \" e \";\n      tempoTexto += `${minutos} ${minutos === 1 ? \"minuto\" : \"minutos\"}`;\n    }\n\n    if (horas === 0 && minutos === 0) {\n      tempoTexto = `${segundos} ${segundos === 1 ? \"segundo\" : \"segundos\"}`;\n    }\n\n    return {\n      horaEntrada,\n      horaFim,\n      tempoInteracao: {\n        horas,\n        minutos,\n        segundos,\n        totalMinutos,\n        totalSegundos\n      },\n      relatorio: `Entrou às ${entradaFormatada.hora} do dia ${entradaFormatada.data} finalizou interação às ${fimFormatada.hora} do dia ${fimFormatada.data} tempo de interação de ${tempoTexto}`\n    };\n  } catch (error) {\n    return {\n      erro: \"Erro ao calcular tempo de interação\"\n    };\n  }\n}",
          "inputVariables": [
            "horaEntrada",
            "horaFim"
          ],
          "outputVariable": "tempoInteracao",
          "LocalTimeZoneEnabled": false
        },
        "conditions": []
      },
      {
        "type": "TrackEvent",
        "settings": {
          "extras": {
            "identificador": "{{contact.identity}}",
            "origem": "{{origem}}",
            "canal": "{{channel}}"
          },
          "category": "tempo de interacao",
          "action": "identificador: {{contact.identity}} | {{tempoInteracao@relatorio}}"
        },
        "conditions": []
      }
    ],
