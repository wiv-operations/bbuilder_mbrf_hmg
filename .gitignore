# Dependencies
node_modules/
.npm/
.pnpm-store/

# Build artifacts
dist/
build/

# OS
.DS_Store
Thumbs.db
._*

# Editor
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.idea/

# Env & secrets — nunca commitar
.env
.env.*
*.local
*.local.json
flows/*/configuration.local.json

# Backups temporários do bbuilder
flows.bak-*/

# Logs de teste (gerados a cada run — não poluir git)
docs/evidencias/*.log
docs/evidencias-execucao-*/

# TypeScript build cache
*.tsbuildinfo

# Chrome headless print temporário
/tmp/

# npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Husky — mantemos .husky/_ ignorado (gerado pelo prepare)
.husky/_/

# Backups do bbuilder — snapshots do estado publicado, podem conter secrets antigos.
# Reconstituíveis via 'bbuilder pull'. Não versionamos.
backup/
