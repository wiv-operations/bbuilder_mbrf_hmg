      {
        "type": "ExecuteScript",
        "settings": {
          "function": "run",
          "source": "function messageToText(messageContent) {\n    if (typeof messageContent === 'string') {\n        return messageContent\n    } else if (messageContent.text && messageContent.options) {\n        const options = messageContent.options.map((o) => o.text).join(', ')\n        return `${messageContent.text} (${options})`\n    } else {\n        return undefined\n    }\n}\n\n/** @param {any} wwthreadsresponse */\n/** @param {string} wwthread */\n/** @param {string} wwlastmessageid */\n/** @param {string} wwassistant */\n/** @param {string} wwlastassistant */\n/** @returns {{ thread: string, skillResponse: string }} */\nfunction run(wwthreadsresponse, wwthread, wwlastmessageid, wwassistant, wwlastassistant, chatgptResponse) {\n    wwthreadsresponse = JSON.parse(wwthreadsresponse)\n\n    if (wwassistant !== wwlastassistant) {\n        return {}\n    }\n\n    if (typeof chatgptResponse === 'string') {\n        return { thread: wwthread, skillResponse: chatgptResponse }\n    }\n\n    const items = wwthreadsresponse && wwthreadsresponse.resource && wwthreadsresponse.resource.items\n    if (Array.isArray(items)) {\n        const lastItemUserMessageIndex = items.findIndex((i) => i.direction === 'received')\n        if (lastItemUserMessageIndex === -1) {\n            return { thread: wwthread }\n        } else {\n            const sentMessages = items.slice(0, lastItemUserMessageIndex)\n            if (sentMessages.length) {\n                return { thread: wwthread, skillResponse: sentMessages.map((m) => messageToText(m.content)).join('\\n') }\n            }\n        }\n    }\n\n    return { thread: wwthread }\n}\n",
