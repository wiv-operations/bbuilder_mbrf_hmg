{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Tests",
            "runtimeArgs": ["--test"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Specific Test File",
            "runtimeArgs": ["--test", "${relativeFile}"],
            "console": "integratedTerminal",
            "skipFiles": ["<node_internals>/**"],
            "cwd": "${workspaceFolder}"
        }
    ]
}
