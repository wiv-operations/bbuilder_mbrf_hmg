{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "WebSearch",
            "Bash(bbuilder validate)",
            "Bash(bbuilder validate:*)",
            "Bash(bbuilder inspect)",
            "Bash(bbuilder inspect:*)",
            "Bash(bbuilder test)",
            "Bash(bbuilder test:*)",
            "Bash(bbuilder pull)",
            "Bash(bbuilder push)",
            "Bash(curl:*)",
            "Bash(head:*)",
            "Bash(grep:*)",
            "Bash(tail:*)",
            "Bash(npm test)",
            "mcp__figma-dev-mode-mcp-server__get_image"
        ],
        "ask": ["Bash(bbuilder publish)", "Bash(bbuilder publish:*)"],
        "deny": [],
        "defaultMode": "acceptEdits"
    },
    "enabledMcpjsonServers": ["figma-dev-mode-mcp-server"],
    "enableAllProjectMcpServers": true
}
